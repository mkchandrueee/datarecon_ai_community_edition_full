# Copy to .env and adjust as needed. All variables are optional; sane
# defaults are used when unset (see config/settings.py).

# Path to the Fernet key used to encrypt stored connection credentials.
# Defaults to data/.datarecon.key (created automatically on first run,
# with owner-only file permissions).
# DATARECON_KEY_PATH=data/.datarecon.key

# Connection test timeout, in seconds.
# DATARECON_CONNECT_TIMEOUT=10

# ---- Scheduling (see ADR-0014) ----
# Timezone cron schedules are read in. Runs are always stored in UTC.
# DATARECON_SCHEDULE_TZ=Asia/Kolkata

# Seconds between scheduler ticks. Cron's resolution is one minute.
# DATARECON_SCHEDULER_INTERVAL=60

# When to notify: failure (default), always, or never.
# DATARECON_NOTIFY_ON=failure

# ---- Email notifications ----
# DATARECON_SMTP_HOST=smtp.example.com
# DATARECON_SMTP_PORT=587
# DATARECON_SMTP_USER=datarecon
# DATARECON_SMTP_PASSWORD=
# DATARECON_SMTP_TLS=true
# DATARECON_NOTIFY_FROM=datarecon@example.com
# DATARECON_NOTIFY_TO=data-team@example.com,oncall@example.com

# ---- Slack / Teams incoming webhook ----
# DATARECON_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
